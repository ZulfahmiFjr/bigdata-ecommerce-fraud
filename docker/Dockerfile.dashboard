FROM python:3.11-slim

WORKDIR /app

# pasang streamlit sama plotly buat tampilan dashboard interaktif yg enteng
RUN pip install --no-cache-dir \
    streamlit==1.41.1 \
    plotly==5.24.1 \
    pymongo==4.10.1 \
    pandas==2.2.3 \
    pyarrow==18.1.0

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

EXPOSE 8501
